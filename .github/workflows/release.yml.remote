name: Release

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Install packaging deps
        run: python -m pip install -r packaging/requirements-build.txt

      - name: Build zip
        shell: pwsh
        run: |
          $version = "${{ github.ref_name }}".TrimStart("v")
          if (-not $version) { $version = "0.0.0" }
          ./packaging/build_release.ps1 -Version $version -Repo "${{ github.repository }}" -PythonExe "python"

      - name: Upload release assets
        uses: softprops/action-gh-release@v2
        with:
          files: |
            dist/SPA-QuickLook-win-x64.zip
            dist/SPA-QuickLook-win-x64.zip.sha256
          generate_release_notes: true
          draft: false
          prerelease: false
